# ========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ========================================
# Copia este archivo a .env para desarrollo local:
# cp .env.example .env

# ========================================
# DEVELOPMENT (Local)
# ========================================
# Backend URL - En desarrollo apunta a tu servidor local
VITE_BACKEND_URL=http://localhost:8000

# ========================================
# PRODUCTION (Render)
# ========================================
# En producción, la variable VITE_BACKEND_URL se configura en:
# Render Dashboard → Settings → Environment → Environment Variables
#
# Variable a configurar:
#   Key: VITE_BACKEND_URL
#   Value: https://back-videos-node-postgres-typescript.onrender.com
#
# NO crear archivo .env.production
# La variable se inyecta durante el build en Render

